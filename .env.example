# ---------------------------------------------------------------------------
# ChennAI Labs — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# General
APP_ENV=development          # development | production
APP_NAME=ChennAI Labs
LOG_LEVEL=INFO

# Session / security (Stage 2+)
# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string
SESSION_TTL_DAYS=7

# Database (Stage 2+)
# Local dev default is SQLite; production points this at Postgres instead.
DATABASE_URL=sqlite:///./chennai_labs.db

# Vector store (Stage 4+)
VECTOR_DB_PATH=./.chroma

# Mesh API (Stage 9+)
# All LLM/embedding calls go through Mesh — never a direct provider key.
# Leave MESH_API_KEY blank for local dev without real credentials: the app
# still runs (auth, catalog, tracking, profile) — product vector sync just
# fails gracefully per Stage 4's dual-write design, and Stage 8's
# recommendations fall back to the popularity ranking. See README's
# "Mesh API integration" section.
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_EMBEDDING_MODEL=mesh-embed-v1
